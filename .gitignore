# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/.cache/
/.playwright-cli/
/output/
__pycache__/
*.py[cod]

# Local live-proof evidence and mutable release state. The harness source and
# policy tests remain tracked; paid-run ledgers, review art, and locks do not.
/launch-fixtures/private/.reference-review/
/launch-fixtures/private/.run-live-proofs.lock/
/launch-fixtures/private/live-proof-budget-ledger.json
/launch-fixtures/private/budget-approval.*.json
/launch-fixtures/private/estimates.*.json

# Runtime databases, secrets, and media always live outside the repository.
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
