# Frozen Google Developer Week judging copy. This file is imported from the
# independent frozen checkout, never from the active Story Scrolls project.
@googledevweekjul_storyscrolls_api {
	host googledevweekjul.corydev.com
	path /health /api/v1/* /api/v2/* /media/community/* /community-sitemap.xml /shared/*
}
handle @googledevweekjul_storyscrolls_api {
	request_body {
		max_size 50MiB
	}
	header X-Robots-Tag "noindex, nofollow, noarchive"
	reverse_proxy 127.0.0.1:4309
}

@googledevweekjul_storyscrolls_unsupported {
	host googledevweekjul.corydev.com
	path /api /api/* /media /media/*
}
handle @googledevweekjul_storyscrolls_unsupported {
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	}
	respond 404
}

@googledevweekjul_storyscrolls_stories {
	host googledevweekjul.corydev.com
	path /stories /stories/*
}
handle @googledevweekjul_storyscrolls_stories {
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; frame-src 'none'; upgrade-insecure-requests"
	}
	@googledevweekjul_story_assets path /stories/*/images/* /stories/*/illuminated/* /stories/*/ai-images/*
	header @googledevweekjul_story_assets Cache-Control "public, max-age=31536000, immutable"
	@googledevweekjul_story_data path /stories/*/story.json /stories/*/ai-illustrations.json
	header @googledevweekjul_story_data Cache-Control "public, max-age=300, must-revalidate"
	root * "/Users/coryboehne/Server Hosting/sites/storyscrolls-googledevweekjul-frozen/dist/client"
	try_files {path} {path}/index.html =404
	file_server
}

@googledevweekjul_storyscrolls_public host googledevweekjul.corydev.com
handle @googledevweekjul_storyscrolls_public {
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; frame-src 'none'; upgrade-insecure-requests"
	}
	@googledevweekjul_assets path /assets/*
	header @googledevweekjul_assets Cache-Control "public, max-age=300, must-revalidate"
	@googledevweekjul_brand path /favicon.svg /favicon.ico /favicon-32x32.png /apple-touch-icon.png /icon-192.png /icon-512.png /icon-maskable-512.png /og.png /site.webmanifest
	header @googledevweekjul_brand Cache-Control "public, max-age=300, must-revalidate"
	root * "/Users/coryboehne/Server Hosting/sites/storyscrolls-googledevweekjul-frozen/dist/client"
	try_files {path} {path}/index.html =404
	file_server
}
